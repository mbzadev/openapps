{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "openapps-web",
  "account_id": "8706f1b6760214ae04dad8c10116be36",
  "main": "src/index.ts",
  "compatibility_date": "2026-08-03",
  "compatibility_flags": ["nodejs_compat"],
  "routes": [
    { "pattern": "apps.mbza.dev", "custom_domain": true }
  ],
  "assets": {
    "directory": "../../web/dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/", "/api/*", "/mcp", "/oauth/*", "/.well-known/*", "/config.js"]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "openapps-production",
      "database_id": "12426f60-ca41-4e4f-a975-718025f1dbfa",
      "migrations_dir": "../../migrations"
    }
  ],
  "kv_namespaces": [
    { "binding": "OAUTH_KV", "id": "ceccf2618dd746d79d2db2ebc888e7e7" }
  ],
  "r2_buckets": [
    { "binding": "ARTIFACTS", "bucket_name": "openapps-artifacts" }
  ],
  "queues": {
    "producers": [
      { "binding": "SYNC_TRACKED_IOS", "queue": "openapps-sync-tracked-ios" },
      { "binding": "SYNC_TRACKED_ANDROID", "queue": "openapps-sync-tracked-android" },
      { "binding": "SYNC_ON_DEMAND_IOS", "queue": "openapps-sync-on-demand-ios" },
      { "binding": "SYNC_ON_DEMAND_ANDROID", "queue": "openapps-sync-on-demand-android" },
      { "binding": "CHARTS_IOS", "queue": "openapps-charts-ios" },
      { "binding": "CHARTS_ANDROID", "queue": "openapps-charts-android" },
      { "binding": "RECONCILE", "queue": "openapps-reconcile" }
    ]
  },
  "ratelimits": [
    { "name": "AUTH_RATE_LIMITER", "namespace_id": "1001", "simple": { "limit": 5, "period": 60 } },
    { "name": "API_RATE_LIMITER", "namespace_id": "1002", "simple": { "limit": 60, "period": 60 } }
  ],
  "vars": {
    "APP_NAME": "OpenApps",
    "APP_URL": "https://apps.mbza.dev",
    "ENVIRONMENT": "production",
    "TRACKED_APP_REFRESH_HOURS": "24"
  },
  "observability": {
    "enabled": true,
    "logs": { "head_sampling_rate": 1 },
    "traces": { "enabled": true, "head_sampling_rate": 0.1 }
  },
  "env": {
    "preview": {
      "routes": [],
      "d1_databases": [
        { "binding": "DB", "database_name": "openapps-preview", "database_id": "b4b15077-8a2a-4a14-aabf-31c7d2fb0e2e", "migrations_dir": "../../migrations" }
      ],
      "kv_namespaces": [
        { "binding": "OAUTH_KV", "id": "5f81131fd1104a6e980690afc975356c" }
      ],
      "r2_buckets": [
        { "binding": "ARTIFACTS", "bucket_name": "openapps-artifacts-preview" }
      ],
      "ratelimits": [
        { "name": "AUTH_RATE_LIMITER", "namespace_id": "1101", "simple": { "limit": 5, "period": 60 } },
        { "name": "API_RATE_LIMITER", "namespace_id": "1102", "simple": { "limit": 60, "period": 60 } }
      ],
      "queues": {
        "producers": [
          { "binding": "SYNC_TRACKED_IOS", "queue": "openapps-sync-tracked-ios-preview" },
          { "binding": "SYNC_TRACKED_ANDROID", "queue": "openapps-sync-tracked-android-preview" },
          { "binding": "SYNC_ON_DEMAND_IOS", "queue": "openapps-sync-on-demand-ios-preview" },
          { "binding": "SYNC_ON_DEMAND_ANDROID", "queue": "openapps-sync-on-demand-android-preview" },
          { "binding": "CHARTS_IOS", "queue": "openapps-charts-ios-preview" },
          { "binding": "CHARTS_ANDROID", "queue": "openapps-charts-android-preview" },
          { "binding": "RECONCILE", "queue": "openapps-reconcile-preview" }
        ]
      },
      "vars": { "APP_NAME": "OpenApps Preview", "APP_URL": "https://openapps-web-preview.mbza.workers.dev", "ENVIRONMENT": "preview", "TRACKED_APP_REFRESH_HOURS": "24" }
    }
  }
}
