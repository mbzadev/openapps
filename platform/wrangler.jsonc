{
  "$schema": "../node_modules/wrangler/config-schema.json",
  "name": "openapps-web",
  "account_id": "8706f1b6760214ae04dad8c10116be36",
  "main": ".open-next/worker.js",
  "compatibility_date": "2026-08-04",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  "routes": [{ "pattern": "apps.mbza.dev", "custom_domain": true }],
  "assets": { "directory": ".open-next/assets", "binding": "ASSETS" },
  "d1_databases": [{
    "binding": "DB",
    "database_name": "openapps-payload-production",
    "database_id": "a969e372-9451-41b9-8adc-fc1f3cb8cfe6",
    "migrations_dir": "../migrations",
    "remote": true
  }],
  "kv_namespaces": [{ "binding": "OAUTH_KV", "id": "ceccf2618dd746d79d2db2ebc888e7e7" }],
  "r2_buckets": [
    { "binding": "ARTIFACTS", "bucket_name": "openapps-artifacts" },
    { "binding": "CREATIVES", "bucket_name": "openapps-creatives" },
    { "binding": "PAYLOAD_MEDIA", "bucket_name": "openapps-payload-media" }
  ],
  "queues": {
    "producers": [
      { "binding": "SYNC_TRACKED_IOS", "queue": "openapps-sync-tracked-ios" },
      { "binding": "SYNC_TRACKED_ANDROID", "queue": "openapps-sync-tracked-android" },
      { "binding": "SYNC_ON_DEMAND_IOS", "queue": "openapps-sync-on-demand-ios" },
      { "binding": "SYNC_ON_DEMAND_ANDROID", "queue": "openapps-sync-on-demand-android" },
      { "binding": "CHARTS_IOS", "queue": "openapps-charts-ios" },
      { "binding": "CHARTS_ANDROID", "queue": "openapps-charts-android" },
      { "binding": "RECONCILE", "queue": "openapps-reconcile" },
      { "binding": "CREATIVE_DISCOVERY", "queue": "openapps-creative-discovery" },
      { "binding": "CREATIVE_MEDIA", "queue": "openapps-creative-media" }
    ]
  },
  "ratelimits": [
    { "name": "AUTH_RATE_LIMITER", "namespace_id": "1001", "simple": { "limit": 5, "period": 60 } },
    { "name": "API_RATE_LIMITER", "namespace_id": "1002", "simple": { "limit": 60, "period": 60 } }
  ],
  "vars": {
    "APP_NAME": "OpenApps",
    "APP_URL": "https://apps.mbza.dev",
    "ENVIRONMENT": "production",
    "TRACKED_APP_REFRESH_HOURS": "24",
    "CREATIVES_ENABLED": "true"
  },
  "observability": {
    "enabled": true,
    "logs": { "head_sampling_rate": 1 },
    "traces": { "enabled": true, "head_sampling_rate": 0.1 }
  }
}
